        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "About"
          }
        }
      }
    },
    "Activa «Ubicación exacta»: sin ella las distancias fallan en 1 o 2 km." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Turn on Precise Location: without it distances are off by 1 or 2 km."
          }
        }
      }
    },
