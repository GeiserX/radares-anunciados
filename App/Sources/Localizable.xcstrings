    "1. Abre Atajos y ve a Automatización." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "1. Open Shortcuts and go to Automation."
          }
        }
      }
    },
    "2. Pulsa + y elige CarPlay." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "2. Tap + and choose CarPlay."
          }
        }
      }
    },
    "3. Marca Conecta y Ejecutar inmediatamente." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "3. Select Connects and Run Immediately."
          }
        }
      }
    },
    "4. Añade la acción «Iniciar aviso de radares»." : {
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "4. Add the action “Iniciar aviso de radares” (Start radar warnings)."
