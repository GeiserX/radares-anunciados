{
  "sourceLanguage": "es",
  "strings": {
    "A-2 km 202,3 · límite 90 km/h": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A-2 km 202.3 · limit 90 km/h"
          }
        }
      }
    },
    "Abre la app": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the app"
          }
        }
      }
    },
    "Empieza a avisar de los radares anunciados y muestra la tarjeta en la pantalla bloqueada y en CarPlay.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starts warning about announced speed cameras and shows the card on the Lock Screen and in CarPlay."
          }
        }
      }
    },
    "Iniciar aviso de radares": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start radar warnings"
          }
        }
      }
    },
    "Parar aviso de radares": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop radar warnings"
          }
        }
      }
    },
    "Radar de prueba": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Test radar"
          }
        }
      }
    },
    "Radar fijo": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed radar"
          }
        }
      }
    },
    "Radar fijo a 600 m": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed radar in 600 m"
          }
        }
      }
    },
    "Radar fijo a 600 metros, sentido Zaragoza. Límite 90.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixed radar in 600 metres, towards Zaragoza. Limit 90."
          }
        }
      }
    },
    "Radares Anunciados": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Radares Anunciados"
          }
        }
      }
    },
    "Termina el viaje: deja de avisar hasta el próximo y quita la tarjeta.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Ends the drive: no more warnings until the next one, and the card goes away."
          }
        }
      }
    }
  },
  "version": "1.0"
}
